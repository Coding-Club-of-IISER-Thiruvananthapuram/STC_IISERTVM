* {
    box-sizing: border-box;
}
body {
    font-family: 'Montserrat', Arial, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    margin: 0;
    color: #222;
    min-height: 100vh;
}
.merch-header {
    background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(45,45,45,0.9));
    color: #fff;
    text-align: center;
    padding: 3rem 1rem 2rem 1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    position: relative;
    overflow: hidden;
}
.merch-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="%23ffffff"/><path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" fill="%23ffffff"/><path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="%23ffffff"/></svg>') no-repeat bottom;
    background-size: cover;
    opacity: 0.1;
}
.merch-header h1 {
    font-size: 3rem;
    margin: 0 0 0.5rem 0;
    letter-spacing: 3px;
    font-weight: 800;
    position: relative;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
.subtitle {
    font-size: 1.3rem;
    color: #e0e0e0;
    margin-bottom: 0.5rem;
    font-weight: 300;
    position: relative;
}
.merch-main {
    max-width: 1200px;
    margin: 3rem auto;
    padding: 0 2rem;
}
.merch-section {
    margin-bottom: 4rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
}
.merch-section h2 {
    font-size: 2.5rem;
    color: #2d2d2d;
    margin-bottom: 2rem;
    font-weight: 800;
    text-align: center;
    position: relative;
    padding-bottom: 1rem;
}
.merch-section h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    border-radius: 2px;
}
.merch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    justify-items: center;
}
.merch-item {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
    padding: 2rem 1.5rem;
    width: 100%;
    max-width: 350px;
    text-align: center;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
}
.merch-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    transform: scaleX(0);
    transition: transform 0.3s ease;
}
.merch-item:hover::before {
    transform: scaleX(1);
}
.merch-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.3);
    border-color: rgba(102, 126, 234, 0.3);
}
.image-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
    border-radius: 12px;
}
.merch-item img {
    width: 100%;
    height: 160px;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
    padding: 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
}
.merch-item img:hover {
    transform: scale(1.05) rotate(2deg);
    box-shadow: 0 4px 16px rgba(102, 126, 234, 0.3);
}
/* Single image (no container) */
.merch-item > img {
    width: 100%;
    max-width: 250px;
    height: 220px;
    object-fit: contain;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    margin: 0 auto 1.5rem auto;
    display: block;
}
.merch-title {
    font-weight: 800;
    background: linear-gradient(135deg, #667eea, #764ba2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 1.3rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
}
.merch-subtitle {
    font-size: 0.9rem;
    color: #888;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
}
.merch-footer {
    background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(45,45,45,0.95));
    color: #fff;
    text-align: center;
    padding: 2rem 1rem;
    font-size: 1rem;
    margin-top: 3rem;
    letter-spacing: 1px;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
}
.merch-footer p {
    margin: 0;
    font-weight: 300;
}
@media (max-width: 768px) {
    .merch-main {
        padding: 0 1rem;
        margin: 2rem auto;
    }
    .merch-section {
        padding: 2rem 1.5rem;
    }
    .merch-section h2 {
        font-size: 2rem;
    }
    .merch-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    .merch-item {
        max-width: 100%;
    }
    .image-container {
        grid-template-columns: 1fr;
        gap: 0.8rem;
    }
    .merch-item img {
        height: 180px;
    }
    .merch-header h1 {
        font-size: 2.2rem;
    }
    .subtitle {
        font-size: 1.1rem;
    }
}
@media (max-width: 480px) {
    .merch-header {
        padding: 2rem 1rem 1.5rem 1rem;
    }
    .merch-header h1 {
        font-size: 1.8rem;
        letter-spacing: 2px;
    }
    .subtitle {
        font-size: 1rem;
    }
    .merch-section {
        padding: 1.5rem 1rem;
        border-radius: 16px;
    }
    .merch-section h2 {
        font-size: 1.6rem;
    }
    .merch-item {
        padding: 1.5rem 1rem;
    }
    .merch-item img {
        height: 140px;
    }
    .merch-title {
        font-size: 1.1rem;
    }
}
